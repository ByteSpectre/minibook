# Base URL of the API. Empty = same origin (`/api`), proxied by Vite in dev and nginx in prod.
VITE_API_URL=
VITE_BOT_USERNAME=glow_beauty_bot
# Optional short name of a named Mini App (t.me/<bot>/<short_name>).
VITE_MINI_APP_SHORT_NAME=
# Yandex Maps JS API v3 key (product: «JavaScript API и HTTP Геокодер»).
# Without it a built-in schematic map is used.
VITE_YANDEX_MAPS_API_KEY=
# Optional Geosuggest key (product: «HTTP Геосаджест») for address autocomplete.
# If empty, VITE_YANDEX_MAPS_API_KEY is reused when that key also has Suggest enabled.
VITE_YANDEX_SUGGEST_API_KEY=
VITE_DEFAULT_LANGUAGE=ru
# Show the persona picker when the app is opened outside Telegram (dev only).
VITE_DEV_AUTH=true
# Dev server proxy target for /api and /uploads.
VITE_API_PROXY_TARGET=http://127.0.0.1:4420
