# ─── Runtime ───────────────────────────────────────────────
NODE_ENV=development
PORT=4420
LOG_LEVEL=info
# Number of reverse proxies in front of the API (nginx = 1). Needed for real client IPs.
TRUST_PROXY=1

# Public URLs
# Base URL of this API as seen by browsers/Telegram (used for upload and .ics links).
PUBLIC_API_URL=http://localhost:4420
# URL of the Mini App (must be https in production for web_app buttons).
WEB_APP_URL=http://localhost:5420
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5420

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://beauty:beauty@localhost:5432/beauty

# ─── Telegram ──────────────────────────────────────────────
# Leave BOT_TOKEN empty to run with a mock bot (messages go to logs and /api/dev/outbox).
BOT_TOKEN=
BOT_USERNAME=glow_beauty_bot
# Optional short name of a named Mini App (t.me/<bot>/<short_name>). Empty = main Mini App.
MINI_APP_SHORT_NAME=
# polling | webhook | off
BOT_MODE=polling
# Secret for Telegram webhook mode (X-Telegram-Bot-Api-Secret-Token).
BOT_WEBHOOK_SECRET=
PLATFORM_OWNER_TELEGRAM_ID=100000
PLATFORM_TIMEZONE=Europe/Moscow

# ─── Auth ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=7d
# Max age of Telegram initData in seconds.
INIT_DATA_MAX_AGE=86400
# Allows /api/auth/dev-login outside Telegram. Never enable in production.
DEV_AUTH_ENABLED=true

# ─── Billing ───────────────────────────────────────────────
MASTER_PRICE_RUB=449
SALON_PRICE_RUB=1249
TRIAL_DAYS=14
SUBSCRIPTION_PERIOD_DAYS=30
REFERRAL_BONUS_DAYS=14
# How many days before the end date the autopayment is attempted.
AUTOPAY_DAYS_BEFORE=1

# Leave YOOKASSA_SHOP_ID/SECRET empty to use the built-in mock checkout.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Secret used to derive the webhook URL token: pnpm --filter @nail-crm/api webhook:url
YOOKASSA_WEBHOOK_SECRET=change-me-webhook-secret
YOOKASSA_ENABLE_RECEIPTS=false
YOOKASSA_INN=
YOOKASSA_DEFAULT_RECEIPT_EMAIL=
# VAT code for receipts (1 = without VAT).
YOOKASSA_VAT_CODE=1
# Skip the YooKassa IP whitelist (only for local testing of the webhook).
YOOKASSA_SKIP_IP_CHECK=false

# ─── Storage ───────────────────────────────────────────────
# local | r2
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
# Public base URL of the bucket (custom domain or r2.dev URL).
R2_PUBLIC_URL=

# ─── Background jobs ───────────────────────────────────────
CRON_ENABLED=true
RATE_LIMIT_ENABLED=true

# ─── Yandex Maps ───────────────────────────────────────────
# Same keys as apps/web/.env. Used by /api/geo/suggest and /api/geo/geocode.
# Maps key = JavaScript API + Geocoder. Suggest key = HTTP Geosuggest.
YANDEX_MAPS_API_KEY=
YANDEX_SUGGEST_API_KEY=
